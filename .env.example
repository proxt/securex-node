# SecureX API (где админка)
API_BASE_URL=

# Тот же секрет, что в securex-api
NODE_SECRET=

# УНИКАЛЬНЫЙ ID
NODE_ID=eu-2

# Название в админке
NODE_NAME=Германия

# ПУБЛИЧНЫЙ IP НОДЫ
NODE_IP=

# SOCKS5 порт (тот же, что в socks5)
NODE_PORT=1080

NODE_TYPE=SOCKS5
NODE_REGION=EU
NODE_TLS=false
NODE_VERSION=1.0.0

# heartbeat
HEARTBEAT_INTERVAL=30
